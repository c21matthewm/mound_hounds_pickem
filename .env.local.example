NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=SET_A_RANDOM_SHARED_SECRET_FOR_VERCEL_CRON

# Optional. Leave blank unless reminder delivery is configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
LEAGUE_ADMIN_EMAIL=indymoundhounds@gmail.com
PICK_EMAILS_ENABLED=false

# Optional race-results automation. Server-only; keep separate from CRON_SECRET.
# Generate independent random secrets with: openssl rand -hex 32
# Match these with GitHub Actions secrets for the in-process worker (see docs/START_HERE.md).
RESULTS_BRIDGE_SECRET=
# Generate locally with node scripts/generate-vapid-keys.mjs; never commit private keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:commissioner@example.com
PICK_PUSH_ENABLED=false
ADMIN_RESULTS_PUSH_ENABLED=true
