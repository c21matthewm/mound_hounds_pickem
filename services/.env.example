# Copy to services/.env.local (ignored). Supply variables explicitly; no dotenv loading.
RESULTS_BRIDGE_URL=http://127.0.0.1:3007/api/internal/results-automation
# TWO independent secrets, each generated separately with openssl rand -hex 32
RESULTS_BRIDGE_SECRET=
RACE_RESULTS_WEBHOOK_SECRET=
RESULTS_MONITOR_ENABLED=false
RACE_RESULTS_WEBHOOK_URL=http://127.0.0.1:8001/api/webhooks/race-results
# --once --in-process uses the same authenticated FastAPI route inside the job.
