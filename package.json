{
  "name": "mound_hounds_pickem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "build": "next build",
    "cleanup:orphaned-images": "node scripts/cleanup-orphaned-images.mjs",
    "cleanup:playwright-artifacts": "node scripts/cleanup-playwright-artifacts.mjs",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "db:types:check": "node scripts/generate-supabase-types.mjs --check",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:smoke": "PW_READ_ONLY=1 playwright test tests/e2e/production-readonly.spec.ts",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:release": "npm run db:types:check && npm run verify"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.11",
    "playwright": "1.58.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "$sharp"
  }
}
